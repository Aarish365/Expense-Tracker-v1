{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arthflow",
  "main": "./server/worker.mjs",
  "compatibility_date": "2026-11-28",
  "workers_dev": true,
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arthflow-db",
      "database_id": "90317286-8ca1-4f7a-a17e-a1dae8980208"
    }
  ],
  "vars": {
    "JWT_EXPIRES_IN": "30d"
  },
  "observability": {
    "enabled": true
  }
}
