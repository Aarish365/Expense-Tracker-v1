{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arthflow",
  "main": "./server/worker.mjs",
  "compatibility_date": "2026-11-28",
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ARTHFLOW_API",
        "class_name": "ArthFlowAPI"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["ArthFlowAPI"]
    }
  ],
  "vars": {
    "JWT_EXPIRES_IN": "30d"
  },
  "observability": {
    "enabled": true
  }
}
