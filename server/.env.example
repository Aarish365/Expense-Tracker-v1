# Server configuration
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
# Local example: mongodb://127.0.0.1:27017/arthflow
MONGO_URI=mongodb://127.0.0.1:27017/arthflow

# Use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=30d

# Frontend URL allowed by CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173
