# ArthFlow no longer uses server/.env.
#
# Local secrets live in the root .dev.vars file (copy .dev.vars.example).
# The database is a Cloudflare D1 binding named DB in wrangler.jsonc.
#
# Keep this file only as a reference for the old standalone Node setup.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5000
